# Copy to .env on the server and fill in. Never commit .env.
# Values containing backslashes are single-quoted so Docker keeps them literally.

# ---- Docker volumes (host side, forward slashes are fine on Windows) ----
MOVIES_HOST_DIR=D:/Media/Movies
CENSORED_HOST_DIR=D:/Media/Censored
WEB_PORT=8787
WORKER_CPUS=4
WORKER_MEMORY=6g

# ---- Plex ----
# Plex runs natively on Windows, so the containers reach it through the host.
PLEX_URL=http://host.docker.internal:32400
# Server owner token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=
# Optional: limit which movie libraries show up (comma list of section ids). Empty = all movie libraries.
PLEX_MOVIE_SECTION_IDS=
# Optional: section id of the "Censored Movies" library. Empty = found by matching CENSORED_HOST_PATH.
PLEX_CENSORED_SECTION_ID=

# ---- Paths ----
# How the paths Plex reports map to paths inside the containers. Separate multiple with ;
PATH_MAPS='D:\Media\Movies=/media/movies'
# The censored folder exactly as Plex sees it (used for targeted library scans)
CENSORED_HOST_PATH='D:\Media\Censored'

# ---- Web ----
# Public URL through Nginx (e.g. https://censor.mckaykleinman.com), used for the Plex sign-in redirect.
# Empty = derive from the request, which is fine for http://kleinmanserver:8787 testing.
PUBLIC_URL=
# Long random string. Empty = generated and stored in the data volume.
SESSION_SECRET=
# Set true once it is served over HTTPS through Nginx
COOKIE_SECURE=false
# Extra admins besides the server owner (Plex usernames, comma list)
ADMIN_USERNAMES=
MAX_ACTIVE_JOBS_PER_USER=3
# Local testing only: skip Plex sign-in
AUTH_DISABLED=false

# ---- Speech (CPU) ----
# large-v3-turbo | distil-large-v3 | large-v3 | medium.en  (run the benchmark tool to choose)
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# generic = verbatim-profanity prompt | subtitles = feed the subtitle text | none
WHISPER_PROMPT_MODE=generic
ALIGN_MODEL=facebook/wav2vec2-base-960h
CPU_THREADS=4

# ---- Windows & matching (seconds) ----
WINDOW_PAD=6.0
WINDOW_MERGE_GAP=2.0
MATCH_TOLERANCE=2.0
# true = always stop for review, even when every hit is confirmed
REVIEW_ALWAYS=false

# ---- Word boundaries (seconds) ----
PRE_PAD=0.08
POST_PAD=0.04
MIN_PAD=0.03
SNAP=0.05
MERGE_GAP=0.15
FADE=0.008
LINE_PAD=0.15

# ---- Render ----
# 5.1: front L/R level while a word is muted (1.0 = untouched, 0 = fully muted)
FRONT_DUCK=0.25
BLEEP_FREQ=1000
BLEEP_LEVEL=0.2
AUDIO_BITRATE_SURROUND=640k
AUDIO_BITRATE_STEREO=224k
KEEP_WORK_FILES=false
